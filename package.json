{
  "name": "converter",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "author": "Owais Khan",
  "license": "Apache-2.0",
  "description": "A free, fast, 100% on-device image and document converter. No uploads, no account, no paywall.",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "test": "jest",
    "test:ci": "jest --ci",
    "tokens:gen": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "license:check": "node scripts/check-licenses.mjs",
    "license:report": "node scripts/check-licenses.mjs --write",
    "telemetry:check": "node scripts/check-no-telemetry.mjs",
    "verify": "npm run typecheck && npm run lint && npm run tokens:check && npm run formats:check && npm run icons:check && npm run telemetry:check && npm run license:check && npm run localizations:check && npm test",
    "formats:gen": "node scripts/gen-formats.mjs",
    "formats:check": "node scripts/gen-formats.mjs --check",
    "generate": "npm run tokens:gen && npm run formats:gen && npm run icons:gen",
    "postinstall": "node scripts/patch-expo-toolchain.mjs",
    "icons:gen": "node scripts/gen-app-icons.mjs",
    "icons:check": "node scripts/gen-app-icons.mjs --check",
    "localizations:check": "node scripts/check-localizations.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@shopify/flash-list": "2.0.2",
    "expo": "~57.0.13",
    "expo-build-properties": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.7",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "codegenConfig": {
    "name": "ConverterCoreSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.owaiskhan.converter"
    }
  }
}

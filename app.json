{
  "expo": {
    "name": "Kitefold",
    "slug": "kitefold",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "kitefold",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.owaiskhan.kitefold",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "NSHumanReadableCopyright": "Copyright (c) 2026 Owais Khan. Licensed under the Apache License, Version 2.0.",
        "NSPhotoLibraryAddUsageDescription": "Kitefold saves your converted images straight to your photo library. It never reads your library — you choose files through the system picker.",
        "CFBundleAllowMixedLocalizations": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Image",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": [
              "public.image",
              "public.heic",
              "public.heif",
              "public.jpeg",
              "public.png",
              "com.compuserve.gif",
              "org.webmproject.webp",
              "public.tiff",
              "com.microsoft.bmp",
              "public.avif",
              "com.microsoft.ico",
              "public.camera-raw-image"
            ]
          },
          {
            "CFBundleTypeName": "PDF",
            "LSHandlerRank": "Alternate",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ]
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.owaiskhan.kitefold",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFBD4",
        "monochromeImage": "./assets/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBD4",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#17110A"
          }
        }
      ],
      "react-native-edge-to-edge",
      "./plugins/withOfflineRelease",
      "./plugins/withConverterCore",
      "./plugins/withLocalizations",
      "./plugins/withShareExtension",
      "./plugins/withConverterCoreAndroid",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "icon": "./assets/icon.png"
  }
}
